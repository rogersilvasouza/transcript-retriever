{
  "name": "transcript-retriever",
  "version": "0.0.0",
  "description": "Recover transcripts from a video",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "node build/main.js",
    "clean": "rm -rf build",
    "build": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run build"
  },
  "author": "Jakub Synowiec <jsynowiec@users.noreply.github.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "puppeteer": "^25.6.0"
  },
  "allowScripts": {
    "puppeteer@25.3.0": true
  }
}
